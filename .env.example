8# Copy this file to .env and fill in your machine's values.
# .env is NOT shared — each person has their own copy.

# ── Database ──────────────────────────────────────────────────────────────────
# Local test DB (Windows auth — leave UID/PWD blank):
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=dbAmazonCustomOrders
DB_UID=
DB_PWD=

# Live Azure DB (SQL auth — fill in UID/PWD):
# DB_SERVER=your-server.database.windows.net
# DB_NAME=dbAmazonCustomOrders
# DB_UID=CustOrderUser
# DB_PWD=CjxcWx9g,ie8?!9PM

# ── Paths (change to match your machine) ──────────────────────────────────────
# Base folder — Fonts, Output, Uploads, Temp all live under here
VARSANY_BASE=C:\Varsany

# Image source folders (comma-separated)
VARSANY_IMAGES=W:\images\Feb-Image,W:\images\Jan-Image

# Extra font folders beyond VARSANY_BASE\Fonts (comma-separated)
VARSANY_FONTS_EXTRA=W:\fonts

# Output, log, temp (defaults to sub-folders of VARSANY_BASE — uncomment to override)
# VARSANY_OUTPUT=C:\Varsany\Output
# VARSANY_LOG=C:\Varsany\batch_log.txt
# VARSANY_TEMP=C:\Varsany\Temp

# ── Google Drive credentials ───────────────────────────────────────────────────
# GDRIVE_CREDENTIALS=C:\Varsany\credentials.json
# GDRIVE_TOKEN=C:\Varsany\gdrive_token.json

# ── Headless Photoshop Bridge (Option 2) ──────────────────────────────────────
# Set to 1 to route orders through real Photoshop instead of the Python writer.
# Photoshop must be open and running ps_worker.jsx before starting batch_processor.
# Falls back to Python writer automatically if PS is not running or no template found.
#
# USE_PHOTOSHOP_BRIDGE=1
#
# Folder where Python drops job files and Photoshop picks them up
# PS_BRIDGE_DIR=C:\Varsany\photoshop_bridge
#
# Folder containing your 28 PSD templates (one per product)
# Layer names inside templates must follow the convention:
#   CustomerImage_front, CustomerText_front
#   CustomerImage_back,  CustomerText_back   (etc.)
# PS_TEMPLATES_DIR=W:\VarsaniAutomation\templates
